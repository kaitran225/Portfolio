# Vercel Environment Configuration
# Production optimizations for the portfolio

# Build optimizations
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false
IMAGE_INLINE_SIZE_LIMIT=0

# React optimizations
FAST_REFRESH=false
REACT_APP_NODE_ENV=production

# Bundle analysis (set to true if you want to analyze bundle size)
ANALYZE=false

# Performance monitoring
REACT_APP_VERCEL_ENV=$VERCEL_ENV
REACT_APP_VERCEL_URL=$VERCEL_URL
REACT_APP_VERCEL_GIT_COMMIT_SHA=$VERCEL_GIT_COMMIT_SHA

# SEO and Analytics
REACT_APP_SITE_URL=https://your-portfolio.vercel.app

# Optional: Add your actual analytics IDs
# REACT_APP_GA_TRACKING_ID=your-ga-id
# REACT_APP_HOTJAR_ID=your-hotjar-id
