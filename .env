# Development Environment Configuration
# Optimize memory usage for large React projects

# Node.js Memory Settings - Only use valid Node.js flags
NODE_OPTIONS=--max-old-space-size=8192

# Suppress Node.js warnings (valid environment variable)
NODE_NO_WARNINGS=1
SUPPRESS_NO_CONFIG_WARNING=true

# Development Server Settings
PORT=3000
BROWSER=none
FAST_REFRESH=true

# Build Optimization
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false

# TypeScript Fork Checker - Optimize memory usage
TSC_COMPILE_ON_ERROR=true
SKIP_PREFLIGHT_CHECK=true
DISABLE_NEW_JSX_TRANSFORM=false
TS_NODE_MEMORY_LIMIT=4096

# ESLint Configuration
ESLINT_NO_DEV_ERRORS=true
DISABLE_ESLINT_PLUGIN=false

# Performance Settings
CHOKIDAR_USEPOLLING=false
WDS_SOCKET_PORT=0

# Suppress Webpack Dev Server Deprecation Warnings
DISABLE_WEBPACK_DEV_SERVER_WARNINGS=true
REACT_APP_DISABLE_WARNINGS=true
