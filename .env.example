# ============= PORTFOLIO ENVIRONMENT CONFIGURATION =============
# Copy this file to .env.local and configure your actual values

# ============= EMAIL SERVICE (EmailJS) =============
# Get these values from https://www.emailjs.com/
# 1. Create account and verify email
# 2. Add email service (Gmail, Outlook, etc.)  
# 3. Create email template with variables: {{from_name}}, {{from_email}}, {{message}}, {{project_type}}
# 4. Get your user ID, service ID, and template ID

REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
REACT_APP_EMAILJS_SERVICE_ID=service_xxxxxxx
REACT_APP_EMAILJS_TEMPLATE_ID=template_xxxxxxx
REACT_APP_EMAILJS_AUTO_REPLY_TEMPLATE_ID=template_auto_reply_xxxxxxx

# ============= ANALYTICS (Google Analytics 4) =============
# Get this from https://analytics.google.com/
# 1. Create GA4 property for your domain
# 2. Get your Measurement ID (starts with G-)

REACT_APP_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ============= PWA CONFIGURATION =============
# Optional: Push notification VAPID keys
# Generate at https://web-push-codelab.glitch.me/
REACT_APP_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ============= PORTFOLIO PERSONALIZATION =============
# Your contact information
REACT_APP_CONTACT_EMAIL=your.email@domain.com
REACT_APP_LINKEDIN_URL=https://linkedin.com/in/yourusername
REACT_APP_GITHUB_URL=https://github.com/yourusername
REACT_APP_DOMAIN=https://your-portfolio-domain.com

# ============= FEATURE TOGGLES =============
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ERROR_TRACKING=true
REACT_APP_ENABLE_EMAIL_CONTACT=true
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true
REACT_APP_ENABLE_PWA_FEATURES=true

# ============= DEVELOPMENT SETTINGS =============
REACT_APP_DEBUG_MODE=true
GENERATE_SOURCEMAP=false

# ============= OPTIONAL INTEGRATIONS =============
# Sentry for advanced error tracking (optional)
# REACT_APP_SENTRY_DSN=https://your-sentry-dsn

# Hotjar for user analytics (optional)  
# REACT_APP_HOTJAR_ID=your_hotjar_id_here

# ============= SETUP INSTRUCTIONS =============
#
# 📧 EmailJS Setup:
#    - Visit https://www.emailjs.com/ and create account
#    - Add your email service (Gmail recommended)
#    - Create template with variables: {{from_name}}, {{from_email}}, {{message}}, {{project_type}}
#    - Copy your Public Key, Service ID, and Template ID
#
# 📊 Google Analytics Setup:
#    - Visit https://analytics.google.com/
#    - Create new GA4 property
#    - Copy your Measurement ID (G-XXXXXXXXXX)
#
# 📱 PWA Testing:
#    - Build production version: npm run build
#    - Serve locally: npx serve -s build
#    - Test PWA features in Chrome DevTools
#
# 🚀 Performance Optimization:
#    - Run: npm run analyze to see bundle composition
#    - Consider code splitting for large dependencies
#    - Optimize images and assets
#
