{
  "name": "react-portfolio",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@react-three/drei": "^10.0.8",
    "@react-three/fiber": "^9.1.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/react-grid-layout": "^1.3.5",
    "@types/react-resizable": "^3.0.8",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.34",
    "@types/three": "^0.176.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^1.5.1",
    "react-resizable": "^3.0.5",
    "react-router-dom": "^7.7.1",
    "react-scripts": "5.0.1",
    "styled-components": "^6.1.18",
    "three": "^0.176.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "copy-assets": "node ./scripts/copyAssets.js",
    "generate-placeholders": "node ./scripts/generatePlaceholders.js",
    "setup": "npm run copy-assets && npm run generate-placeholders && npm start",
    "build-portfolio": "npm run copy-assets && npm run generate-placeholders && npm run build",
    "deploy-prep": "npm run build-portfolio && node -e \"console.log('\\n🎯 Portfolio built successfully!\\n\\nTwo versions available:\\n• Full Interactive: Build folder or host /\\n• Simple Clean: Add ?view=simple to URL\\n\\n📤 Ready for deployment!')\"",
    "preview": "npx serve build -s"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
