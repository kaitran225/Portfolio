  "scripts": {
    "start": "react-scripts start",
    "build": "npm run copy-assets && npm run generate-placeholders && react-scripts build",
    "build:vercel": "npm run copy-assets && npm run generate-placeholders && react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --coverage --watchAll=false --ci",
    "copy-assets": "node ./scripts/copyAssets.js",
    "generate-placeholders": "node ./scripts/generatePlaceholders.js",
    "update-cv": "node ./scripts/update-cv-pdf.js",
    "preview": "npx serve build -s",
    "analyze": "npm run build && npx bundle-analyzer build/static/js/*.js",
    "postbuild": "echo 'Build completed successfully for Vercel deployment'",
    "deploy": "node ./scripts/deploy.js",
    "deploy:prod": "node ./scripts/deploy.js --prod",
    "vercel:dev": "vercel dev",
    "vercel:logs": "vercel logs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
